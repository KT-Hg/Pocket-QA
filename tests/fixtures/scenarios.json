  {
    "name": "TEST 06 — Loading State Condition (Screen 2)",
    "actions": [
      {
        "type": "script",
        "code": "showScreen(2, document.querySelectorAll('nav button')[1])",
        "label": "Go to Screen 2"
      },
      {
        "type": "wait",
        "value": "300"
      },
      {
        "type": "click",
        "selector": "button.btn-ghost",
        "selectors": { "css": "#screen2 .section:last-child .btn-ghost", "text": "Reset", "textTag": "button" },
        "label": "Click: Reset loading state"
      },
      {
        "type": "wait",
        "value": "300"
      },
      {
        "type": "click",
        "selector": "button.btn-primary",
        "selectors": { "css": "#screen2 button.btn-primary:last-of-type", "text": "Simulate Load (1.5s)", "textTag": "button" },
        "label": "Click: Simulate Load (1.5s)"
      },
      {
        "type": "condition",
        "selector": "#loadingSpinner",
        "selectors": { "css": "#loadingSpinner", "id": "loadingSpinner" },
        "conditionType": "elementVisible",
        "conditionSkipCount": 1,
        "label": "IF spinner visible → skip 1 (wait for it to disappear)"
      },
      {
        "type": "wait",
        "value": "300",
        "label": "[SKIPPED] Short wait — skipped because spinner is showing"
      },
      {
        "type": "condition",
        "selector": ".spinner",
        "selectors": { "css": ".spinner" },
        "conditionType": "elementNotExists",
        "conditionSkipCount": 0,
        "timeout": 4000,
        "label": "Wait up to 4s: spinner gone (elementNotExists — skip 0 = only gate)",
        "disabled": true
      },
      {
        "type": "wait",
        "value": "2000",
        "label": "Wait 2s for load to complete"
      },
      {
        "type": "readdom",
        "selector": "#loadedValue",
        "selectors": { "css": "#loadedValue", "id": "loadedValue" },
        "readFrom": "text",
        "varName": "loadedResult",
        "label": "Read DOM: loaded result → ${loadedResult}"
      },
      {
        "type": "condition",
        "selector": "#loadedContent",
        "selectors": { "css": "#loadedContent", "id": "loadedContent" },
        "conditionType": "elementVisible",
        "conditionSkipCount": 0,
        "label": "Assert: #loadedContent is visible (skip 0 = no-op assert)"
      }
    ]
  },

