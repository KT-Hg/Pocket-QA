  {
    "name": "TEST 03 — Run JS & Read DOM (Screen 2)",
    "actions": [
      {
        "type": "script",
        "code": "showScreen(2, document.querySelectorAll('nav button')[1])",
        "label": "Go to Screen 2"
      },
      {
        "type": "wait",
        "value": "300"
      },
      {
        "type": "click",
        "selector": "#btnInc",
        "selectors": { "css": "#btnInc", "id": "btnInc", "xpath": "//*[@id=\"btnInc\"]" },
        "label": "Click: Increment counter"
      },
      {
        "type": "click",
        "selector": "#btnInc",
        "selectors": { "css": "#btnInc", "id": "btnInc", "xpath": "//*[@id=\"btnInc\"]" },
        "label": "Click: Increment counter"
      },
      {
        "type": "click",
        "selector": "#btnInc",
        "selectors": { "css": "#btnInc", "id": "btnInc", "xpath": "//*[@id=\"btnInc\"]" },
        "label": "Click: Increment counter (total = 3)"
      },
      {
        "type": "readdom",
        "selector": "#counter",
        "selectors": { "css": "#counter", "id": "counter", "xpath": "//*[@id=\"counter\"]" },
        "readFrom": "text",
        "varName": "counterValue",
        "label": "Read DOM: counter → ${counterValue}"
      },
      {
        "type": "script",
        "code": "document.getElementById('jsOutput').textContent = 'Counter read by readdom: ' + document.getElementById('counter').textContent",
        "label": "Run JS: write to output panel"
      },
      {
        "type": "readdom",
        "selector": "#domPrice",
        "selectors": { "css": "#domPrice", "id": "domPrice", "xpath": "//*[@id=\"domPrice\"]" },
        "readFrom": "text",
        "varName": "price",
        "label": "Read DOM: price → ${price}"
      },
      {
        "type": "readdom",
        "selector": "#domStock",
        "selectors": { "css": "#domStock", "id": "domStock", "xpath": "//*[@id=\"domStock\"]" },
        "readFrom": "text",
        "varName": "stock",
        "label": "Read DOM: stock → ${stock}"
      },
      {
        "type": "readdom",
        "selector": "#domRating",
        "selectors": { "css": "#domRating", "id": "domRating", "xpath": "//*[@id=\"domRating\"]" },
        "readFrom": "text",
        "varName": "rating",
        "label": "Read DOM: rating → ${rating}"
      },
      {
        "type": "script",
        "code": "document.getElementById('jsOutput').textContent += '\\nPrice: ' + document.getElementById('domPrice').textContent + ' | Stock: ' + document.getElementById('domStock').textContent + ' | Rating: ' + document.getElementById('domRating').textContent",
        "label": "Run JS: display read values"
      },
      {
        "type": "click",
        "selector": "#btnDec",
        "selectors": { "css": "#btnDec", "id": "btnDec", "xpath": "//*[@id=\"btnDec\"]" },
        "label": "Click: Decrement"
      },
      {
        "type": "click",
