        "selectors": { "css": "#btnReset2", "id": "btnReset2", "xpath": "//*[@id=\"btnReset2\"]" },
        "label": "Click: Reset counter"
      }
    ]
  },

  {
    "name": "TEST 04 — Condition (if) (Screen 2)",
    "actions": [
      {
        "type": "script",
        "code": "showScreen(2, document.querySelectorAll('nav button')[1])",
        "label": "Go to Screen 2"
      },
      {
        "type": "wait",
        "value": "300"
      },
      {
        "type": "click",
        "selector": "#btnHide",
        "selectors": { "css": "#btnHide", "id": "btnHide", "xpath": "//*[@id=\"btnHide\"]" },
        "label": "Click: Hide element"
      },
      {
        "type": "wait",
        "value": "300"
      },
      {
        "type": "condition",
        "selector": "#conditionEl",
        "selectors": { "css": "#conditionEl", "id": "conditionEl" },
        "conditionType": "elementHidden",
        "conditionSkipCount": 2,
        "label": "IF elementHidden #conditionEl → skip 2 (increment + wait)"
      },
      {
        "type": "click",
        "selector": "#btnInc",
        "selectors": { "css": "#btnInc", "id": "btnInc" },
        "label": "[SKIPPED] Increment — should be skipped"
      },
      {
        "type": "wait",
        "value": "500",
        "label": "[SKIPPED] Wait — should be skipped"
      },
      {
        "type": "click",
        "selector": "#btnShow",
        "selectors": { "css": "#btnShow", "id": "btnShow", "xpath": "//*[@id=\"btnShow\"]" },
        "label": "Click: Show element"
      },
      {
        "type": "wait",
        "value": "300"
      },
      {
        "type": "condition",
        "selector": "#conditionEl",
        "selectors": { "css": "#conditionEl", "id": "conditionEl" },
        "conditionType": "elementVisible",
        "conditionSkipCount": 1,
        "label": "IF elementVisible #conditionEl → skip 1 (hide action)"
      },
      {
        "type": "click",
        "selector": "#btnHide",
        "selectors": { "css": "#btnHide", "id": "btnHide" },
        "label": "[SKIPPED] Hide — should be skipped because element IS visible"
      },
      {
        "type": "condition",
        "selector": "#condText",
        "selectors": { "css": "#condText", "id": "condText" },
        "conditionType": "textContains",
        "expectedValue": "Condition target",
        "conditionSkipCount": 1,
        "label": "IF #condText contains 'Condition target' → skip 1"
      },
      {
        "type": "click",
        "selector": "#btnInc",
        "selectors": { "css": "#btnInc", "id": "btnInc" },
        "label": "[SKIPPED] Increment — skipped because text matched"
      },
      {
        "type": "condition",
        "conditionType": "urlContains",
        "expectedValue": "test-page",
        "conditionSkipCount": 1,
        "label": "IF URL contains 'test-page' → skip 1"
      },
      {
        "type": "click",
        "selector": "#btnInc",
        "selectors": { "css": "#btnInc", "id": "btnInc" },
        "label": "[SKIPPED] Increment — skipped because URL matched"
      }
    ]
  },

